{
  "name": "legend-of-the-red-dragon",
  "version": "1.0.0",
  "description": "Legend of the Red Dragon (1994) — a Phaser 3 platformer, packaged for the desktop",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.panchiko.reddragon",
    "productName": "Legend of the Red Dragon",
    "files": [
      "electron-main.cjs",
      "index.html",
      "src/**/*",
      "vendor/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "LegendOfTheRedDragon.exe"
    }
  }
}
